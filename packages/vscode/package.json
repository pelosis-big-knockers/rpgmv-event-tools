{
	"name": "rpgmv-event-tools",
	"displayName": "RPG Maker MV Event Tools",
	"description": "Read, navigate and edit RPG Maker MV event logic as readable script.",
	"version": "0.0.1",
	"private": true,
	"publisher": "p-b-k",
	"license": "MIT",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/pelosis-big-knockers/rpgmv-event-tools.git",
		"directory": "packages/vscode"
	},
	"bugs": {
		"url": "https://github.com/pelosis-big-knockers/rpgmv-event-tools/issues"
	},
	"homepage": "https://github.com/pelosis-big-knockers/rpgmv-event-tools#readme",
	"categories": [
		"Other"
	],
	"keywords": [
		"rpg maker",
		"rpg maker mv",
		"rpgmv",
		"rpgmaker",
		"modding",
		"events"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"workspaceContains:**/data/System.json",
		"onFileSystem:rpgmv"
	],
	"contributes": {
		"commands": [
			{
				"command": "rpgmvEventTools.openContainer",
				"title": "Open Event Script",
				"category": "RPG Maker MV"
			},
			{
				"command": "rpgmvEventTools.filterExplorer",
				"title": "Filter Events…",
				"shortTitle": "Filter…",
				"category": "RPG Maker MV",
				"icon": "$(filter)"
			},
			{
				"command": "rpgmvEventTools.clearExplorerFilter",
				"title": "Clear Event Filter",
				"shortTitle": "Clear Filter",
				"category": "RPG Maker MV",
				"icon": "$(clear-all)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "rpgmvEventTools.openContainer",
					"when": "false"
				},
				{
					"command": "rpgmvEventTools.clearExplorerFilter",
					"when": "rpgmvEventTools.explorerFiltered"
				}
			],
			"view/title": [
				{
					"command": "rpgmvEventTools.filterExplorer",
					"when": "view == rpgmvEventTools.explorer",
					"group": "navigation@1"
				},
				{
					"command": "rpgmvEventTools.clearExplorerFilter",
					"when": "view == rpgmvEventTools.explorer && rpgmvEventTools.explorerFiltered",
					"group": "navigation@2"
				}
			]
		},
		"configuration": {
			"title": "RPG Maker MV Event Tools",
			"properties": {
				"rpgmvEventTools.showEmptyEntries": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "Show empty slots in the explorer: common events and troops with no name and no commands. Map events are always shown."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "rpgmvEventTools",
					"title": "RPG Maker MV",
					"icon": "images/activity-bar.svg"
				}
			]
		},
		"views": {
			"rpgmvEventTools": [
				{
					"id": "rpgmvEventTools.explorer",
					"name": "Events",
					"icon": "images/activity-bar.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "rpgmvEventTools.explorer",
				"when": "!rpgmvEventTools.explorerFiltered",
				"contents": "No RPG Maker MV project was found in this workspace. Open a game's folder: the one with data/System.json, or www/data/System.json in a deployed game."
			}
		],
		"languages": [
			{
				"id": "rpgmv-script",
				"aliases": [
					"RPG Maker MV Script",
					"rpgmv-script"
				],
				"extensions": [
					".mvscript"
				],
				"configuration": "./syntaxes/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "rpgmv-script",
				"scopeName": "source.rpgmv-script",
				"path": "./syntaxes/rpgmv-script.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"build": "node esbuild.mjs",
		"watch": "node esbuild.mjs --watch",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"vscode:prepublish": "npm run clean && node esbuild.mjs --production",
		"prepackage": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
		"package": "vsce package --no-dependencies",
		"pretest:extension": "npm run build && esbuild test/extension/suite.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --alias:@rpgmv-event-tools/core=../core/src/index.ts --outfile=out/test/suite.js --log-level=warning",
		"test:extension": "node test/extension/run.mjs"
	},
	"dependencies": {
		"@rpgmv-event-tools/core": "*"
	}
}
