{
	"$comment": "The script is TypeScript syntax with raw strings (docs/script-syntax.md). This grammar is VS Code's TypeScript grammar plus an injection for the places the script differs. The injection applies inside every TypeScript rule (blocks, calls, arrays, ...), and its L: priority makes its rules win over TypeScript's at the same position, so TypeScript's own strings never start. It stays out of comments, strings, script(...) arguments and command(...) arguments.",
	"name": "RPG Maker MV Script",
	"scopeName": "source.rpgmv-script",
	"patterns": [
		{
			"include": "source.ts"
		}
	],
	"injections": {
		"L:source.rpgmv-script -comment -string -meta.embedded -meta.script-arguments -meta.raw-fallback-arguments": {
			"patterns": [
				{
					"include": "#raw-fallback"
				},
				{
					"include": "#script-call"
				},
				{
					"include": "#string"
				}
			]
		}
	},
	"repository": {
		"raw-fallback": {
			"$comment": "Spec 7.7: command(code, parameters). The parameters are a JavaScript literal whose strings do use JavaScript escapes, so TypeScript's own rules read them.",
			"name": "meta.function-call.raw-fallback.rpgmv-script",
			"begin": "(?<![_$[:alnum:].])(command)\\s*(\\()",
			"beginCaptures": {
				"1": {
					"name": "support.function.raw-fallback.rpgmv-script"
				},
				"2": {
					"name": "meta.brace.round.rpgmv-script"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "meta.brace.round.rpgmv-script"
				}
			},
			"contentName": "meta.raw-fallback-arguments.rpgmv-script",
			"patterns": [
				{
					"include": "source.ts#expression"
				}
			]
		},
		"script-call": {
			"$comment": "Spec 8.1-8.3: script(\"...\", ...) (Script, and a script condition or operand) and the move-route step .script(\"...\"), whose string arguments are JavaScript. plugin.script(...) is a plugin command, so a step's dot must follow a ) or start the line.",
			"name": "meta.function-call.script.rpgmv-script",
			"begin": "(?:(?<![_$[:alnum:].])(script)|(?:(?<=\\))\\s*|^\\s*)(\\.)\\s*(script))\\s*(\\()",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.script.rpgmv-script"
				},
				"2": {
					"name": "punctuation.accessor.rpgmv-script"
				},
				"3": {
					"name": "entity.name.function.script.rpgmv-script"
				},
				"4": {
					"name": "meta.brace.round.rpgmv-script"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "meta.brace.round.rpgmv-script"
				}
			},
			"contentName": "meta.script-arguments.rpgmv-script",
			"patterns": [
				{
					"include": "#script-string"
				},
				{
					"include": "source.ts#expression"
				}
			]
		},
		"script-string": {
			"$comment": "A raw string holding one line of JavaScript. Each string is matched whole, and a capture's patterns only see the captured text, so the JavaScript can never run past the closing quote.",
			"patterns": [
				{
					"match": "(\")([^\"]*)(\"|$)",
					"captures": {
						"1": {
							"name": "string.quoted.double.rpgmv-script punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"name": "meta.embedded.line.js",
							"patterns": [
								{
									"include": "source.js"
								}
							]
						},
						"3": {
							"name": "string.quoted.double.rpgmv-script punctuation.definition.string.end.rpgmv-script"
						}
					}
				},
				{
					"match": "(')([^']*)('|$)",
					"captures": {
						"1": {
							"name": "string.quoted.single.rpgmv-script punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"name": "meta.embedded.line.js",
							"patterns": [
								{
									"include": "source.js"
								}
							]
						},
						"3": {
							"name": "string.quoted.single.rpgmv-script punctuation.definition.string.end.rpgmv-script"
						}
					}
				},
				{
					"match": "(`)([^`]*)(`|$)",
					"captures": {
						"1": {
							"name": "string.quoted.other.backtick.rpgmv-script punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"name": "meta.embedded.line.js",
							"patterns": [
								{
									"include": "source.js"
								}
							]
						},
						"3": {
							"name": "string.quoted.other.backtick.rpgmv-script punctuation.definition.string.end.rpgmv-script"
						}
					}
				},
				{
					"$comment": "Never matches. vscode-textmate only loads the grammars that patterns refer to, not those that captures refer to, so this makes it load the JavaScript grammar.",
					"begin": "(?!)",
					"end": "(?!)",
					"patterns": [
						{
							"include": "source.js"
						}
					]
				}
			]
		},
		"string": {
			"$comment": "Spec 4.4: raw strings. A backslash never escapes, so a string ends at the first matching quote on its line. A backtick string is not a template.",
			"patterns": [
				{
					"name": "string.quoted.double.rpgmv-script",
					"match": "(\")([^\"]*)(\"|$)",
					"captures": {
						"1": {
							"name": "punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"patterns": [
								{
									"include": "#text-code"
								}
							]
						},
						"3": {
							"name": "punctuation.definition.string.end.rpgmv-script"
						}
					}
				},
				{
					"name": "string.quoted.single.rpgmv-script",
					"match": "(')([^']*)('|$)",
					"captures": {
						"1": {
							"name": "punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"patterns": [
								{
									"include": "#text-code"
								}
							]
						},
						"3": {
							"name": "punctuation.definition.string.end.rpgmv-script"
						}
					}
				},
				{
					"name": "string.quoted.other.backtick.rpgmv-script",
					"match": "(`)([^`]*)(`|$)",
					"captures": {
						"1": {
							"name": "punctuation.definition.string.begin.rpgmv-script"
						},
						"2": {
							"patterns": [
								{
									"include": "#text-code"
								}
							]
						},
						"3": {
							"name": "punctuation.definition.string.end.rpgmv-script"
						}
					}
				}
			]
		},
		"text-code": {
			"$comment": "Spec 4.5, kept in step with CODE in packages/core/src/text-codes.ts: \\\\ first, then \\G (even before more letters), then letters with an optional [argument], then one symbol. Codes the core engine defines are text-code; others (from plugins) are text-code.unknown. A backslash that starts no code is plain text.",
			"patterns": [
				{
					"name": "constant.character.escape.text-code.rpgmv-script",
					"match": "\\\\\\\\"
				},
				{
					"name": "constant.character.escape.text-code.rpgmv-script",
					"match": "\\\\[Gg]"
				},
				{
					"name": "constant.character.escape.text-code.rpgmv-script",
					"match": "\\\\[VvNnPpCcIi]\\[[0-9]+\\]"
				},
				{
					"name": "constant.character.escape.text-code.unknown.rpgmv-script",
					"match": "\\\\[A-Za-z]+(?:\\[[^\\[\\]\\\\]*\\])?"
				},
				{
					"name": "constant.character.escape.text-code.rpgmv-script",
					"match": "\\\\[{}$.|!<>^]"
				},
				{
					"name": "constant.character.escape.text-code.unknown.rpgmv-script",
					"match": "\\\\[!-/:-@\\[-`{-~]"
				}
			]
		}
	}
}
