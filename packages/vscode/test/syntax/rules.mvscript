/// <reference types="rpgmv-event-tools" />

// Hand-written cases for each rule of the grammar.

defineCommonEvent({ id: 1, name: "Raw strings", trigger: "none" }, () => {
	// A backslash never escapes: each string ends at its first matching quote.
	showText("C:\");
	showText('Wait...\');
	showText(`Done\`);
	showText("\\");
	showText("Ends\", "next");
	showText('She said "hi".');
	showText(`"It's late," he said.`);
	showText(`"It's` + "`" + `" too.`);
	showText(`${variables.Day} is not a template`);
	showText("no // comment here");
});

defineCommonEvent({ id: 2, name: "Text codes", trigger: "none" }, () => {
	showText("\C[2]Mira\C[0] has \V[12] \G, or \Gold: \N[1], \n[1], \P[1], \I[64], \v[03].");
	showText("\{Big\} \. \| \! \> fast \< \^ \$ \\ literal");
	showText("Plugin \fs[20] \msgposx[a] \C[x] \C \Cx[2] \V[] \# \_ \~ \[");
	showText("Stray \1 \ space, and at the end \");
	showText('Single \C[3]quoted\C[0]', `backtick \N[2]`);
	comment("Codes in \C[2]any\C[0] raw string");
});

defineCommonEvent({ id: 3, name: "JavaScript lambdas", trigger: "none" }, () => {
	// A lambda's body is JavaScript: its strings have escapes and no text codes.
	script(() => {
		$gameVariables.setValue(1, 'ok');
		$gameMessage.add("She said \"hi\" \C[2]");
		var path = 'C:\\', slash = "\\";

		var s = `template ${1 + 2}
		  still the template ${"}"})`; // a comment )
		if ($gameSwitches.value(2)) { f(a, [b, { c: ")" }]); }
	});
	script(() => $gameMessage.add("It's " + 'late'));
	script(() => ({ a: "\"" }));
	if (script(() => $gameParty.size() > 2 && /[")]/.test(s))) {
		variables.Day = script(() => Math.floor(Math.random() * 3));
	}
	script(
		() =>
			$gameVariables.value(1111111111111111111111111111111111111111) + $gameVariables.value("\")"),
	);
	setMovementRoute(player, { skippable: true })
		.turnUp()
		.script(() => this.setOpacity(128))
		.script(() => this._opacity = "x\"");
	setMovementRoute(event).moveUp().script(() => this.jump(0, 0));
	// The string fallback, and calls that aren't lambdas, have raw strings.
	script("var path = 'C:\';", "if (");
	script(
		"$gameVariables.value(1111111111111111111111111111111111111111) + $gameVariables.value(\C[2]\",
	);
	if (script("Input.isPressed('ok');")) {
	}
	setMovementRoute(player).script("this.jump(0, 0);").moveUp();
	plugin.script("not", "JavaScript \C[2]");
	commonEvents.script();
	showText('script(() => "not a call")');
});

defineCommonEvent({ id: 4, name: "Raw fallback", trigger: "none" }, () => {
	command(232, [1, 0, 0, 0, 408, 312, 100, 100, 255, 0, 60, true]);
	command(401, ["\\c[2]Escaped\"", 'it\'s'], { indent: 3 });
	command({ code: 108, indent: 0, parameters: ["…"], extra: 1 });
	plugin.command("raw", "\C[2]");
	showText("command(1, [])");
});

// A string with no closing quote runs to the end of its line.
showText("unterminated
);
